{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name configured in Cloudflare Workers Builds.
  "name": "express-tournament",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "express-tournament-db",
      // Not a secret: only usable with credentials for this Cloudflare account.
      "database_id": "6d5c964f-97d7-4ee6-90d2-326377d6c93b",
      "migrations_dir": "migrations"
    }
  ],
  // Branch previews (Workers Builds) must never touch production data.
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "express-tournament-db-preview",
        "database_id": "f976a9e4-5047-4d23-8524-0b777f6eb03f",
        "migrations_dir": "migrations"
      }
    ]
  },
  "observability": {
    "enabled": true
  }
}
